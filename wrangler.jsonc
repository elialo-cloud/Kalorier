{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalorier",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalorier-db",
      "database_id": "50f3a68e-b4fa-46f8-b9f4-e3c362908088"
    }
  ]
}
